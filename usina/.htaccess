# Paginas da usina, eletroposto e hibrida.
#
# O Hostinger servia HTML e JS com Cache-Control de 7 dias. Quem ja tinha aberto
# a pagina continuava vendo a versao antiga (sem portao de lead) e podia juntar
# um HTML novo com um motor.js velho do cache. HTML e JS sao revalidados sempre;
# imagens seguem em cache, porque trocam de nome quando mudam.
<IfModule mod_headers.c>
  <FilesMatch "\.(html?|js)$">
    Header set Cache-Control "no-cache, must-revalidate"
    Header unset Expires
  </FilesMatch>
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 0 seconds"
  ExpiresByType text/javascript "access plus 0 seconds"
</IfModule>
